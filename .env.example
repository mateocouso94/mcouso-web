# Copia este fichero como .env en el servidor (el .env no se sube a git).
# Dirección interna de Uptime Kuma, accesible desde homelab-apps:
KUMA_URL=http://192.168.0.X:3001
# Opcional: monitor Push de Uptime Kuma para vigilar el despliegue automático (sin ?status=...):
KUMA_PUSH_URL=http://192.168.0.30:3001/api/push/<token>
