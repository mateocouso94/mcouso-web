# Copia este fichero como infra/replica-pi/.env en la Pi (el .env no se sube a git).
# Guarda una copia de estos valores en Bitwarden: es lo único que no se puede recrear desde el repo.

# Token del túnel: Zero Trust → Networks → Tunnels → (tu túnel) → Configure → el valor tras --token
TUNNEL_TOKEN=

# Para consultar qué conectores tiene vivos el túnel (solo lectura).
# Token: My Profile → API Tokens → Create Custom Token → permiso "Account · Cloudflare Tunnel · Read"
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_TUNNEL_ID=

# Arquitectura del cloudflared de homelab tal como la da la API (la Pi es linux_arm64).
HOMELAB_ARCH=linux_amd64

# Minutos seguidos sin homelab antes de tomar el relevo, y con homelab antes de devolverlo.
TAKEOVER_AFTER=3
RELEASE_AFTER=5

# Opcional: avisos por Telegram (bot de @BotFather y tu chat id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
