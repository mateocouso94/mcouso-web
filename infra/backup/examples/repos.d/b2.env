# /etc/homelab-backup/repos.d/b2.env — copia fuera de casa en Backblaze B2.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/mcouso-homelab-backup/homelab-red
AWS_ACCESS_KEY_ID=<keyID>
AWS_SECRET_ACCESS_KEY=<applicationKey>
RESTIC_PASSWORD_FILE=/etc/homelab-backup/password
KUMA_PUSH_URL=http://192.168.0.20:3001/api/push/<token-copia-b2>
