# /etc/homelab-backup/repos.d/local.env — copia en el OTRO mini PC (por SFTP).
# En homelab-red apunta a homelab-apps, y al revés.
RESTIC_REPOSITORY=sftp:resticbk@192.168.0.30:/homelab-red
RESTIC_PASSWORD_FILE=/etc/homelab-backup/password
# Monitor Push de Kuma para esta copia (sin ?status=...)
KUMA_PUSH_URL="http://192.168.0.20:3001/api/push/TOKEN-COPIA-LOCAL"
