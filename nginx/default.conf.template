# Plantilla de nginx. Al arrancar, el contenedor sustituye ${KUMA_URL} por su valor
# (ver compose.yaml y .env) y genera /var/run/default.conf.
server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Cabeceras de seguridad
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    # CSP: solo recursos propios. 'unsafe-inline' en scripts lo necesita Next.js para arrancar la página;
    # cloudflareinsights.com es Cloudflare Web Analytics (sin cookies).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/json text/plain;

    # Ficheros con hash en el nombre: caché larga
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Estado del homelab: solo se reenvían estas dos consultas de lectura a Uptime Kuma.
    # El panel de Kuma no se expone. Si KUMA_URL no está configurado, responden 502
    # y la web muestra "estado no disponible".
    location = /api/status/homelab {
        limit_except GET { deny all; }
        proxy_pass ${KUMA_URL}/api/status-page/homelab;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /api/status/heartbeat/homelab {
        limit_except GET { deny all; }
        proxy_pass ${KUMA_URL}/api/status-page/heartbeat/homelab;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        proxy_hide_header Set-Cookie;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location = /.well-known/security.txt {
        default_type text/plain;
        add_header Cache-Control "public, max-age=86400";
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
